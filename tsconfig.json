{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@core": ["core/index.ts"],
      "@core/draw": ["core/draw/index.ts"],
      "@core/volume": ["core/volume/index.ts"],
      "@core/rig": ["core/rig/index.ts"],
      "@/*": ["viewer/src/*"]
    }
  },
  "include": [
    "core/**/*",
    "tools/**/*",
    "viewer/**/*",
    "templates/**/*",
    "projects/**/*",
    "examples/**/*"
  ]
}
